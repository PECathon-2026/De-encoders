# =====================================================================
# DevPilot: The Mystic Mikado's Autonomous AI Engineering Guild (PS-001)
# Environment Variables Reference
# =====================================================================
# Copy this file to ai-orchestration/.env and fill in real values.
# NEVER commit sensitive API keys to Git.
# =====================================================================

# ─── AI Orchestration Server ──────────────────────────────────────────
PORT=3000

# ─── Mistral AI API Key (Free Experimenter Tier) ──────────────────────
# Obtain a 100% free key at: https://console.mistral.ai -> "API Keys"
# Free experimenter tier gives monthly tokens with no credit card required.
MISTRALAI_API_KEY=your_mistral_api_key_here
MISTRAL_API_KEY=your_mistral_api_key_here

# ─── Target Workspace Directory (Optional) ───────────────────────────
# Defaults to ../sandbox/template (a React 19 + Vite + Vitest workspace)
# WORKSPACE_DIR=../sandbox/template

# ─── Frontend Dev Server (frontend/.env) ──────────────────────────────
# VITE_BACKEND_URL=http://localhost:3000
